# Copy to .env for local development. All settings live in app/config.py.
# (Comments stay on their own lines: `docker run --env-file` does not strip inline comments.)
OPENAI_API_KEY=sk-...
# Comma-separated client keys accepted in the X-API-Key header
API_KEYS=local-dev-key

# Optional overrides
# ENV=dev
# LLM_MODEL=gpt-4o-mini
# Offline eval only
# JUDGE_MODEL=gpt-4.1
# MAX_REFINEMENTS=2
# TOP_K=3
# MIN_SIMILARITY=0.50
# RATE_LIMIT_PER_MINUTE=10
# DAILY_QUOTA_PER_KEY=200
# GLOBAL_DAILY_QUOTA=1000
# METRICS_ENABLED=true
# LOG_QUERY_TEXT=false
# MLFLOW_TRACKING_URI=http://localhost:5000
# EMBED_THREADS=2
